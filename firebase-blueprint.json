{
  "entities": {
    "Turma": {
      "title": "Turma",
      "description": "Turma escolar da E.M. Ricardo Misson",
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "description": "Nome da turma (obrigatório)",
          "minLength": 1,
          "maxLength": 100
        },
        "turno": {
          "type": "string",
          "description": "Turno escolar (facultativo)",
          "maxLength": 50
        },
        "anoLetivo": {
          "type": "string",
          "description": "Ano letivo (facultativo)",
          "maxLength": 20
        },
        "sala": {
          "type": "string",
          "description": "Identificação da sala (facultativo)",
          "maxLength": 50
        },
        "cargaHorariaTotal": {
          "type": "number",
          "description": "Carga horária total anual prevista em horas (facultativo)"
        },
        "professorReferencia": {
          "type": "string",
          "description": "Nome da professora de referência (facultativo)",
          "maxLength": 120
        },
        "observacoes": {
          "type": "string",
          "description": "Observações pedagógicas da turma (facultativo)",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "Data de criação"
        },
        "updatedAt": {
          "type": "string",
          "description": "Data de atualização"
        },
        "createdBy": {
          "type": "string",
          "description": "UID do usuário criador",
          "maxLength": 128
        }
      },
      "required": ["nome"]
    },
    "Aluno": {
      "title": "Aluno",
      "description": "Aluno matriculado na E.M. Ricardo Misson",
      "type": "object",
      "properties": {
        "turmaId": {
          "type": "string",
          "description": "ID da turma vinculada",
          "maxLength": 128
        },
        "nome": {
          "type": "string",
          "description": "Nome completo do estudante (obrigatório)",
          "minLength": 1,
          "maxLength": 150
        },
        "matricula": {
          "type": "string",
          "description": "Matrícula escolar ou código do aluno (facultativo)",
          "maxLength": 50
        },
        "dataNascimento": {
          "type": "string",
          "description": "Data de nascimento (facultativo)",
          "maxLength": 20
        },
        "responsavelNome": {
          "type": "string",
          "description": "Nome do responsável legal (facultativo)",
          "maxLength": 150
        },
        "responsavelTelefone": {
          "type": "string",
          "description": "Telefone/WhatsApp do responsável (facultativo)",
          "maxLength": 40
        },
        "responsavelEmail": {
          "type": "string",
          "description": "E-mail do responsável (facultativo)",
          "maxLength": 120
        },
        "endereco": {
          "type": "string",
          "description": "Endereço e bairro do estudante (facultativo)",
          "maxLength": 250
        },
        "observacoes": {
          "type": "string",
          "description": "Observações pedagógicas ou histórico (facultativo)",
          "maxLength": 1000
        },
        "ativo": {
          "type": "boolean",
          "description": "Indica se o aluno está ativo na turma"
        },
        "createdAt": {
          "type": "string",
          "description": "Data de criação"
        },
        "updatedAt": {
          "type": "string",
          "description": "Data de atualização"
        },
        "createdBy": {
          "type": "string",
          "description": "UID do usuário criador",
          "maxLength": 128
        }
      },
      "required": ["nome", "turmaId"]
    },
    "Falta": {
      "title": "Falta",
      "description": "Registro de ausência/infrequência escolar",
      "type": "object",
      "properties": {
        "alunoId": {
          "type": "string",
          "description": "ID do aluno",
          "maxLength": 128
        },
        "turmaId": {
          "type": "string",
          "description": "ID da turma",
          "maxLength": 128
        },
        "data": {
          "type": "string",
          "description": "Data da falta (YYYY-MM-DD)",
          "maxLength": 20
        },
        "horasFalta": {
          "type": "number",
          "description": "Quantidade de horas letivas perdidas"
        },
        "motivo": {
          "type": "string",
          "description": "Motivo relatado (facultativo)",
          "maxLength": 250
        },
        "justificada": {
          "type": "boolean",
          "description": "Se a falta foi justificada (facultativo)"
        },
        "observacoes": {
          "type": "string",
          "description": "Observações (facultativo)",
          "maxLength": 500
        },
        "registradoPor": {
          "type": "string",
          "description": "Nome do professor ou usuário que registrou",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "Data de criação"
        },
        "updatedAt": {
          "type": "string",
          "description": "Data de atualização"
        },
        "createdBy": {
          "type": "string",
          "description": "UID do usuário criador",
          "maxLength": 128
        }
      },
      "required": ["alunoId", "turmaId", "data", "horasFalta"]
    },
    "Atestado": {
      "title": "Atestado",
      "description": "Atestado médico ou documento comprobatório de saúde",
      "type": "object",
      "properties": {
        "alunoId": {
          "type": "string",
          "description": "ID do aluno",
          "maxLength": 128
        },
        "turmaId": {
          "type": "string",
          "description": "ID da turma",
          "maxLength": 128
        },
        "dataInicio": {
          "type": "string",
          "description": "Data de início do atestado (YYYY-MM-DD)",
          "maxLength": 20
        },
        "dataTermino": {
          "type": "string",
          "description": "Data de término do atestado (YYYY-MM-DD)",
          "maxLength": 20
        },
        "diasAfastamento": {
          "type": "number",
          "description": "Número de dias de afastamento (facultativo)"
        },
        "horasAbonadas": {
          "type": "number",
          "description": "Carga horária correspondente abonada (facultativo)"
        },
        "cid": {
          "type": "string",
          "description": "Código CID-10 (facultativo)",
          "maxLength": 20
        },
        "crm": {
          "type": "string",
          "description": "CRM do médico (facultativo)",
          "maxLength": 30
        },
        "medicoNome": {
          "type": "string",
          "description": "Nome do médico/profissional de saúde (facultativo)",
          "maxLength": 120
        },
        "motivo": {
          "type": "string",
          "description": "Motivo médico/diagnóstico resumido (facultativo)",
          "maxLength": 300
        },
        "observacoes": {
          "type": "string",
          "description": "Observações (facultativo)",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "Data de criação"
        },
        "updatedAt": {
          "type": "string",
          "description": "Data de atualização"
        },
        "createdBy": {
          "type": "string",
          "description": "UID do usuário criador",
          "maxLength": 128
        }
      },
      "required": ["alunoId", "turmaId", "dataInicio", "dataTermino"]
    },
    "Intervencao": {
      "title": "Intervencao",
      "description": "Intervenção pedagógica realizada para evitar a evasão escolar",
      "type": "object",
      "properties": {
        "alunoId": {
          "type": "string",
          "description": "ID do aluno",
          "maxLength": 128
        },
        "turmaId": {
          "type": "string",
          "description": "ID da turma",
          "maxLength": 128
        },
        "data": {
          "type": "string",
          "description": "Data da intervenção (YYYY-MM-DD)",
          "maxLength": 20
        },
        "tipo": {
          "type": "string",
          "description": "Tipo de ação pedagógica (busca ativa, ligação, reunião, FICAI, etc.)",
          "maxLength": 100
        },
        "descricao": {
          "type": "string",
          "description": "Detalhes da ação executada (facultativo)",
          "maxLength": 1000
        },
        "responsavelAcao": {
          "type": "string",
          "description": "Professora de referência ou coordenadora responsável (facultativo)",
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "description": "Status da intervenção (ex: Concluída, Em Andamento, Pendente)",
          "maxLength": 50
        },
        "resultado": {
          "type": "string",
          "description": "Resultado ou compromisso firmado com o estudante/família (facultativo)",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "Data de criação"
        },
        "updatedAt": {
          "type": "string",
          "description": "Data de atualização"
        },
        "createdBy": {
          "type": "string",
          "description": "UID do usuário criador",
          "maxLength": 128
        }
      },
      "required": ["alunoId", "turmaId", "data", "tipo"]
    }
  },
  "firestore": {
    "/turmas/{turmaId}": {
      "schema": {
        "$ref": "#/entities/Turma"
      },
      "description": "Coleção de turmas da escola"
    },
    "/alunos/{alunoId}": {
      "schema": {
        "$ref": "#/entities/Aluno"
      },
      "description": "Coleção de alunos matriculados"
    },
    "/faltas/{faltaId}": {
      "schema": {
        "$ref": "#/entities/Falta"
      },
      "description": "Registros de faltas e infrequências dos alunos"
    },
    "/atestados/{atestadoId}": {
      "schema": {
        "$ref": "#/entities/Atestado"
      },
      "description": "Registros de atestados médicos e justificativas"
    },
    "/intervencoes/{intervencaoId}": {
      "schema": {
        "$ref": "#/entities/Intervencao"
      },
      "description": "Registros de intervenções pedagógicas contra evasão escolar"
    }
  }
}
